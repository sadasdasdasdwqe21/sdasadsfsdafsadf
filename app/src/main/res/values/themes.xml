<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ll_background">#FF0B0F17</color>
    <color name="ll_accent">#FF4FD1C5</color>
    <color name="ll_icon_bg">#FF101826</color>

    <style name="Theme.LiveLingo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ll_background</item>
        <item name="android:statusBarColor">@color/ll_background</item>
        <item name="android:navigationBarColor">@color/ll_background</item>
        <item name="android:colorAccent">@color/ll_accent</item>
    </style>

    <style name="Theme.LiveLingo.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
